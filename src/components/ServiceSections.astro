---
interface Feature {
  title: string;
  description: string;
  iconPath: string;
}

interface Step {
  title: string;
  description: string;
}

interface Props {
  accent: 'blue' | 'cyan' | 'violet' | 'red' | 'emerald' | 'amber' | 'indigo' | 'teal';
  eyebrow: string;
  title: string;
  heroDescription: string;
  heroIconPath: string;
  heroImage: string;
  features: Feature[];
  steps: Step[];
  featuresHeading?: string;
  processHeading?: string;
  scopeIndex?: string;
  processIndex?: string;
}

const {
  accent,
  eyebrow,
  title,
  heroDescription,
  heroIconPath,
  heroImage,
  features,
  steps,
  featuresHeading = 'Ce include serviciul',
  processHeading = 'Cum lucrăm',
  scopeIndex = '01 / SCOPE',
  processIndex = '02 / PROCES',
} = Astro.props;

// Brand v2: pe fundal dark folosim cyan ca singur accent.
// Mapă accent → blob hint color (subtle), păstrăm prop-ul pentru retrocompatibilitate.
const blobMap = {
  blue:    'bg-brand-cyan-500/10',
  cyan:    'bg-brand-cyan-500/10',
  violet:  'bg-signal-info/10',
  red:     'bg-signal-down/10',
  emerald: 'bg-signal-up/10',
  amber:   'bg-signal-warn/10',
  indigo:  'bg-signal-info/10',
  teal:    'bg-brand-cyan-500/10',
} as const;

const blob = blobMap[accent];
---

<!-- Hero -->
<section class="relative bg-ink-800 pt-32 pb-20 overflow-hidden brand-grid-bg">
  <div class:list={['absolute top-20 right-0 w-[420px] h-[420px] rounded-full blur-3xl opacity-60 pointer-events-none', blob]}></div>

  <div class="relative max-w-6xl mx-auto px-6">
    <div class="flex flex-col-reverse lg:flex-row lg:items-center gap-10 lg:gap-16">
      <!-- Text -->
      <div class="lg:w-1/2">
        <span class="brand-eyebrow mb-6">{eyebrow}</span>
        <h1 class="mt-5 text-[32px] md:text-[48px] font-display font-bold text-surface-50 tracking-tight leading-[1.1]">
          {title}
        </h1>
        <p class="mt-5 text-surface-200 text-[17px] md:text-[18px] leading-relaxed font-light">
          {heroDescription}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-8">
          <a
            href="/contact"
            class="inline-flex items-center justify-center gap-2 bg-brand-cyan-500 hover:bg-brand-cyan-400 text-ink-900 font-semibold text-[15px] px-7 py-3.5 rounded-full transition-all shadow-lg shadow-brand-cyan-500/20 hover:shadow-xl hover:shadow-brand-cyan-500/30"
          >
            Solicită o consultație
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
          </a>
          <a href="tel:+40727897849" class="inline-flex items-center justify-center gap-2 border border-ink-500 text-surface-300 hover:text-surface-50 hover:border-brand-cyan-500/60 text-[15px] px-7 py-3.5 rounded-full transition-all">
            <svg class="w-5 h-5 text-brand-cyan-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
            +40 727 897 849
          </a>
        </div>
      </div>

      <!-- Image -->
      <div class="lg:w-1/2">
        <div class="relative">
          <div class="absolute -inset-2 bg-brand-cyan-500/10 rounded-3xl blur-2xl pointer-events-none"></div>
          <img
            src={heroImage}
            alt={title}
            class="relative w-full rounded-2xl shadow-2xl object-cover aspect-[4/3] border border-ink-600"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section class="py-20 md:py-24 bg-ink-900 relative">
  <div class="max-w-6xl mx-auto px-6">
    <div class="brand-section-head">
      <div class="index"><strong>{scopeIndex}</strong></div>
      <div>
        <h2 class="text-[26px] md:text-[36px] font-display font-bold text-surface-50 leading-tight">{featuresHeading}</h2>
        <p class="mt-3 text-surface-300 text-[16px] font-light max-w-2xl">
          Abordare practică, documentată și aliniată la standardele industriei — pentru continuitate operațională.
        </p>
      </div>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((f) => (
        <div class="brand-card group hover:border-brand-cyan-500/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5 bg-brand-cyan-500/10 group-hover:scale-105 transition-transform">
            <svg class="w-6 h-6 text-brand-cyan-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={f.iconPath} />
            </svg>
          </div>
          <h3 class="text-surface-50 font-semibold text-lg mb-2 font-display">{f.title}</h3>
          <p class="text-surface-300 text-[15px] leading-relaxed font-light">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Process -->
<section class="py-20 md:py-24 bg-ink-800">
  <div class="max-w-6xl mx-auto px-6">
    <div class="brand-section-head">
      <div class="index"><strong>{processIndex}</strong></div>
      <div>
        <h2 class="text-[26px] md:text-[36px] font-display font-bold text-surface-50 leading-tight">{processHeading}</h2>
        <p class="mt-3 text-surface-300 text-[16px] font-light max-w-2xl">
          Un parcurs clar, de la evaluare la operare — fără surprize și cu raportare transparentă.
        </p>
      </div>
    </div>
    <div class="grid md:grid-cols-3 gap-10 md:gap-8">
      {steps.map((step, i) => (
        <div class="relative">
          {i < steps.length - 1 && (
            <div class="hidden md:block absolute top-8 left-[calc(50%+2rem)] w-[calc(100%-4rem)] h-px bg-ink-500" aria-hidden="true"></div>
          )}
          <div class="w-14 h-14 rounded-2xl bg-brand-cyan-500 text-ink-900 font-bold text-xl flex items-center justify-center mb-5 shadow-lg shadow-brand-cyan-500/20 font-mono">
            {String(i + 1).padStart(2, '0')}
          </div>
          <h3 class="text-surface-50 font-semibold text-xl mb-2 font-display">{step.title}</h3>
          <p class="text-surface-300 text-[15px] leading-relaxed font-light">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-20 md:py-24 bg-ink-900 relative overflow-hidden brand-grid-bg">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/3 left-1/4 w-[380px] h-[380px] bg-brand-cyan-500/10 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-0 right-1/4 w-[320px] h-[320px] bg-signal-info/10 rounded-full blur-[100px]"></div>
  </div>
  <div class="relative z-10 max-w-3xl mx-auto px-6 text-center">
    <span class="brand-eyebrow justify-center">03 / NEXT STEP</span>
    <h2 class="mt-6 text-[28px] md:text-[40px] font-display font-bold text-surface-50 leading-tight mb-4">
      Pregătit să îmbunătățești infrastructura IT?
    </h2>
    <p class="text-surface-300 text-[16px] md:text-[17px] font-light mb-10">
      Discutăm despre nevoile tale și îți propunem un plan concret, adaptat bugetului și obiectivelor afacerii.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="/contact" class="group inline-flex items-center gap-2 bg-brand-cyan-500 hover:bg-brand-cyan-400 text-ink-900 font-semibold text-[16px] px-8 py-4 rounded-full transition-all shadow-lg shadow-brand-cyan-500/25">
        Solicită o consultație
        <svg class="w-5 h-5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
      </a>
      <a href="tel:+40727897849" class="inline-flex items-center gap-2 text-surface-300 hover:text-surface-50 text-[16px] transition-colors">
        <svg class="w-5 h-5 text-brand-cyan-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
        +40 727 897 849
      </a>
    </div>
  </div>
</section>
