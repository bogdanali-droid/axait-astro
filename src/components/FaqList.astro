---
import type { FaqItem } from './faq';

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="space-y-4">
  {items.map((item) => (
    <article id={item.id} class="brand-card p-6 md:p-8 scroll-mt-28">
      <h3 class="font-display text-surface-50 text-[19px] md:text-[22px] font-medium leading-snug mb-3">{item.q}</h3>
      <div data-faq-answer>
        <p class="text-surface-200 text-[16px] leading-relaxed font-light">{item.a}</p>
        {item.links.length > 0 && (
          <p class="mt-3 text-[14px] text-surface-400">
            Detalii:{' '}
            {item.links.map((link, i) => (
              <Fragment>
                {i > 0 && ' · '}
                <a
                  href={link.href}
                  class="text-brand-cyan-500 hover:text-brand-cyan-400 underline decoration-brand-cyan-500/40 underline-offset-4 transition-colors"
                  {...(link.href.startsWith('http') ? { rel: 'noopener' } : {})}
                >{link.label}</a>
              </Fragment>
            ))}
          </p>
        )}
      </div>
    </article>
  ))}
</div>
