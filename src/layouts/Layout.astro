---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = "AXA IT oferă soluții IT complete, adaptate afacerii tale — mentenanță, rețelistică, cloud, securitate și monitorizare automată 24/7 cu suport tehnic Lu-Vi 08-18.",
  image = "/og-image-1200x630.png",
  type = "website"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://axait.ro");
const ogImage = image.startsWith('http') ? image : `https://axait.ro${image}`;
const fullTitle = title.length > 45 ? title : `${title} | AXA IT`;
---

<!DOCTYPE html>
<html lang="ro" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>

  <link rel="canonical" href={canonicalURL} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <!-- Theme color (Brand v3 light: paper + cyan accent) -->
  <meta name="theme-color" content="#FFFFFF">
  <meta name="msapplication-TileColor" content="#19B6E6">

  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content="AXA IT" />
  <meta property="og:locale" content="ro_RO" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalURL} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts: Geist (legacy, Faza 1) + Brand v2 (Inter body, Manrope display, JetBrains Mono) -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap">
  <style>
    @font-face {
      font-family: 'Geist';
      src: url('https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/Geist-Regular.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Geist';
      src: url('https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/Geist-Medium.woff2') format('woff2');
      font-weight: 500;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Geist';
      src: url('https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/Geist-SemiBold.woff2') format('woff2');
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }
    @font-face {
      font-family: 'Geist';
      src: url('https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/Geist-Light.woff2') format('woff2');
      font-weight: 300;
      font-style: normal;
      font-display: swap;
    }
  </style>

  <!-- LocalBusiness + WebSite Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "LocalBusiness",
        "@id": "https://axait.ro/#business",
        "name": "AXA IT",
        "url": "https://axait.ro",
        "foundingDate": "2016",
        "logo": {
          "@type": "ImageObject",
          "url": "https://axait.ro/img/logo/axait-logo.png"
        },
        "image": "https://axait.ro/og-image-1200x630.png",
        "description": "Soluții IT complete pentru firme din București — mentenanță, rețelistică, cloud, securitate și outsourcing IT. 8+ ani experiență (din 2016), 150+ sisteme active.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Dealul Tugulea 64",
          "addressLocality": "București",
          "addressCountry": "RO"
        },
        "telephone": "+40-727-897-849",
        "email": "office@axa-it.ro",
        "priceRange": "€€",
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
            "opens": "08:00",
            "closes": "18:00"
          }
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+40-727-897-849",
          "contactType": "customer service",
          "availableLanguage": "Romanian"
        },
        "areaServed": [
          {"@type": "City", "name": "București"},
          {"@type": "Country", "name": "România"}
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Servicii IT",
          "itemListElement": [
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Mentenanță IT"}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Outsourcing IT"}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Cloud & Backup"}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Protecție Cibernetică"}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Rețelistică & Wi-Fi"}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Securitate & Supraveghere"}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Virtualizare Servere"}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Consultanță & Audit IT"}}
          ]
        },
        "sameAs": [
          "https://www.facebook.com/axait.ro",
          "https://www.instagram.com/axait.ro"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://axait.ro/#website",
        "url": "https://axait.ro",
        "name": "AXA IT",
        "description": "Soluții IT complete pentru firme din București",
        "publisher": {"@id": "https://axait.ro/#business"},
        "inLanguage": "ro-RO"
      }
    ]
  }
  </script>

  <slot name="schema" />
</head>
<body class="antialiased bg-brand-light text-brand-dark">
  <slot />

  <!-- WhatsApp Floating Button -->
  <a
    href="https://wa.me/40727897849?text=Bună%20ziua!%20Aș%20dori%20mai%20multe%20informații%20despre%20serviciile%20AXA%20IT."
    target="_blank"
    rel="noopener"
    aria-label="Contactează-ne pe WhatsApp"
    class="whatsapp-fab group fixed bottom-6 right-6 z-[100] flex items-center"
  >
    <span class="hidden group-hover:flex items-center mr-3 bg-white text-[#0B1226] text-[14px] font-medium px-4 py-2 rounded-full shadow-lg border border-brand-border/40 whitespace-nowrap transition-all">
      Scrie-ne pe WhatsApp
    </span>
    <span class="relative flex items-center justify-center w-14 h-14 bg-[#25D366] rounded-full shadow-lg shadow-[#25D366]/30 hover:shadow-xl hover:shadow-[#25D366]/40 hover:scale-105 transition-all">
      <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
      <span class="absolute -top-0.5 -right-0.5 w-3.5 h-3.5 bg-red-500 rounded-full border-2 border-white animate-pulse"></span>
    </span>
  </a>
</body>
</html>

<style is:global>
  /* === Brand v3 design tokens (light theme) — disponibile global pentru utility classes manuale === */
  /* Numele "ink-*" si "surface-*" raman pentru compatibilitate, dar valorile sunt inversate. */
  :root {
    --ink-900: #FFFFFF;
    --ink-800: #F8FAFC;
    --ink-700: #F1F5F9;
    --ink-600: #E2E8F0;
    --ink-500: #CBD5E1;
    --ink-400: #94A3B8;

    --cyan-500: #0E8FBA;
    --cyan-400: #19B6E6;
    --cyan-600: #0A6A8C;
    --cyan-700: #085571;
    --cyan-900: #062C3D;

    --surface-50: #0B1226;
    --surface-200: #1A2548;
    --surface-300: #334155;
    --surface-400: #475569;
    --surface-500: #64748B;

    --signal-up: #16C784;
    --signal-warn: #F5A623;
    --signal-down: #E64545;
    --signal-info: #6C8CFF;

    --font-display: 'Manrope', system-ui, sans-serif;
    --font-body: 'Inter', system-ui, sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, monospace;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html, body {
    font-family: 'Inter', 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
    overflow-x: hidden;
    width: 100%;
    max-width: 100vw;
  }

  body { background: #FFFFFF; color: #0B1226; }

  ::selection {
    background: #0E8FBA;
    color: #FFFFFF;
  }

  ::-webkit-scrollbar {
    width: 8px;
  }

  ::-webkit-scrollbar-track {
    background: rgba(11, 18, 38, 0.05);
  }

  ::-webkit-scrollbar-thumb {
    background: #0E8FBA;
    border-radius: 4px;
  }

  .glass-card {
    background: rgba(11, 18, 38, 0.04);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(11, 18, 38, 0.08);
  }

  .glass-card-light {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.05); }
  }

  @keyframes pulse-node {
    0%, 100% { r: 7; opacity: 0.8; }
    50% { r: 9; opacity: 1; }
  }

  @keyframes travel {
    0% { offset-distance: 0%; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { offset-distance: 100%; opacity: 0; }
  }

  @keyframes grow-bar {
    0% { transform: scaleY(0); }
    100% { transform: scaleY(1); }
  }

  @keyframes slide-up {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes marquee-reverse {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  @keyframes fade-in {
    0% { opacity: 0; transform: translateY(30px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .animate-float {
    animation: float 5s ease-in-out infinite;
    contain: layout style;
  }

  .animate-pulse-slow {
    animation: pulse-slow 8s ease-in-out infinite;
    contain: layout style;
  }

  .animate-grow-bar {
    animation: grow-bar 1.2s ease-out forwards;
    transform-origin: bottom;
  }

  .animate-marquee {
    animation: marquee 45s linear infinite;
    display: flex;
    width: max-content;
  }

  .animate-marquee-reverse {
    animation: marquee-reverse 40s linear infinite;
    display: flex;
    width: max-content;
  }

  .brand-marquee:hover .animate-marquee,
  .brand-marquee:hover .animate-marquee-reverse {
    animation-play-state: paused;
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-100 { animation-delay: 100ms; }
  .animation-delay-200 { animation-delay: 200ms; }
  .animation-delay-300 { animation-delay: 300ms; }
  .animation-delay-400 { animation-delay: 400ms; }
  .animation-delay-500 { animation-delay: 500ms; }
  .animation-delay-600 { animation-delay: 600ms; }
  .animation-delay-1000 { animation-delay: 1000ms; }
  .animation-delay-2000 { animation-delay: 2000ms; }
  .animation-delay-3000 { animation-delay: 3000ms; }

  /* === Brand v2 utility classes — prefix `brand-` ca să evite coliziuni cu paginile actuale === */
  /* Sunt disponibile global; Faza 2 le va wrap în primitive Astro (Eyebrow.astro, Pill.astro etc.) */

  .brand-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--cyan-500);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .brand-eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--cyan-500);
  }

  .brand-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    background: rgba(25, 182, 230, 0.12);
    color: var(--cyan-500);
    border: 1px solid rgba(25, 182, 230, 0.3);
  }
  .brand-pill.brand-pill-ok {
    background: rgba(22, 199, 132, 0.12);
    color: var(--signal-up);
    border-color: rgba(22, 199, 132, 0.3);
  }
  .brand-pill.brand-pill-no {
    background: rgba(230, 69, 69, 0.12);
    color: var(--signal-down);
    border-color: rgba(230, 69, 69, 0.3);
  }

  .brand-wordmark {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.04em;
    display: inline-flex;
    gap: 0.25em;
    line-height: 1;
  }
  .brand-wordmark .axa { color: #0B1226; }
  .brand-wordmark .it { color: var(--cyan-500); }
  .brand-wordmark.brand-wordmark-mono-white .axa,
  .brand-wordmark.brand-wordmark-mono-white .it { color: #FFFFFF; }
  .brand-wordmark.brand-wordmark-mono-ink .axa,
  .brand-wordmark.brand-wordmark-mono-ink .it { color: #0B1226; }

  .brand-grid-bg { position: relative; }
  .brand-grid-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(25, 182, 230, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(25, 182, 230, 0.06) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center center;
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 90%);
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, #000 30%, transparent 90%);
    pointer-events: none;
    z-index: 0;
  }
  .brand-grid-bg > * { position: relative; z-index: 1; }

  .brand-section-head {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 48px;
    align-items: end;
    margin-bottom: 64px;
  }
  .brand-section-head .index {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--surface-400);
  }
  .brand-section-head .index strong {
    color: var(--cyan-500);
    font-weight: 500;
  }
  @media (max-width: 800px) {
    .brand-section-head { grid-template-columns: 1fr; gap: 16px; }
  }

  .brand-spec-row {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid rgba(11, 18, 38, 0.1);
    align-items: baseline;
  }
  .brand-spec-row .label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--surface-400);
  }
  .brand-spec-row .value { color: var(--surface-50); }
  .brand-spec-row .tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--cyan-500);
    text-align: right;
  }
  @media (max-width: 720px) {
    .brand-spec-row { grid-template-columns: 1fr; gap: 4px; }
    .brand-spec-row .tag { text-align: left; }
  }

  .brand-card {
    background: var(--ink-800);
    border: 1px solid rgba(11, 18, 38, 0.08);
    border-radius: 20px;
    padding: 32px;
    position: relative;
    overflow: hidden;
  }
  .brand-card.brand-card-glow::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 20px;
    padding: 1px;
    background: linear-gradient(135deg, var(--cyan-500), transparent 40%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    pointer-events: none;
  }
</style>
