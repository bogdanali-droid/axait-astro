import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact"
  description="Contactează AXA IT — telefon, email, adresă în București. Solicită o consultație sau trimite-ne un mesaj."
>
  <Header variant="dark" currentPage="/contact" />

  <main class="bg-ink-900 min-h-screen">
    <!-- Hero -->
    <section class="relative pt-32 pb-16 md:pb-20 bg-ink-900 overflow-hidden">
      <div class="brand-grid-bg absolute inset-0 opacity-50"></div>
      <div class="absolute top-20 right-0 w-[400px] h-[400px] bg-brand-cyan-500/10 rounded-full blur-[100px] pointer-events-none" />
      <div class="relative max-w-6xl mx-auto px-6">
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <p class="brand-eyebrow">— 01 / Channels</p>
          <span class="brand-pill brand-pill-ok">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-signal-up opacity-60"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-signal-up"></span>
            </span>
            Status: Operational
          </span>
        </div>
        <h1 class="font-display text-[40px] md:text-[56px] font-medium leading-[1.05] tracking-tight bg-gradient-to-br from-white via-surface-100 to-surface-300 bg-clip-text text-transparent">Contact</h1>
        <p class="mt-5 text-surface-300 text-[17px] md:text-[18px] max-w-2xl leading-relaxed font-light">
          Ai nevoie de o consultație sau de suport IT? Sună-ne, scrie-ne sau completează formularul — îți răspundem prompt.
        </p>
      </div>
    </section>

    <!-- Contact cards + form -->
    <section class="pb-24 bg-ink-900">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-14">
          <a
            href="tel:+40727897849"
            class="brand-card brand-card-glow group p-6 block"
          >
            <div class="w-12 h-12 bg-brand-cyan-500/10 rounded-2xl flex items-center justify-center mb-4 text-brand-cyan-500 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
            </div>
            <p class="brand-eyebrow mb-2">Telefon</p>
            <p class="text-surface-50 font-medium text-[17px] group-hover:text-brand-cyan-500 transition-colors">+40 727 897 849</p>
            <p class="font-mono text-surface-400 text-[11px] uppercase tracking-[0.12em] mt-2">Luni–Vineri · 08:00–18:00</p>
          </a>

          <a
            href="mailto:office@axa-it.ro"
            class="brand-card brand-card-glow group p-6 block"
          >
            <div class="w-12 h-12 bg-brand-cyan-500/10 rounded-2xl flex items-center justify-center mb-4 text-brand-cyan-500 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <p class="brand-eyebrow mb-2">Email</p>
            <p class="text-surface-50 font-medium text-[17px] group-hover:text-brand-cyan-500 transition-colors break-all">office@axa-it.ro</p>
            <p class="font-mono text-surface-400 text-[11px] uppercase tracking-[0.12em] mt-2">Răspuns în cel mai scurt timp</p>
          </a>

          <div class="brand-card p-6">
            <div class="w-12 h-12 bg-brand-cyan-500/10 rounded-2xl flex items-center justify-center mb-4 text-brand-cyan-500">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <p class="brand-eyebrow mb-2">Adresă</p>
            <p class="text-surface-50 font-medium text-[17px] leading-snug">Dealul Tugulea 64</p>
            <p class="text-surface-300 text-[14px] mt-1 font-light">București, România</p>
          </div>

          <div class="brand-card p-6">
            <div class="w-12 h-12 bg-brand-cyan-500/10 rounded-2xl flex items-center justify-center mb-4 text-brand-cyan-500">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="brand-eyebrow mb-2">Program</p>
            <p class="text-surface-50 font-medium text-[17px]">Lu–Vi · 08–18</p>
            <p class="font-mono text-surface-400 text-[11px] uppercase tracking-[0.12em] mt-2">Sa–Du · Închis</p>
          </div>
        </div>

        <!-- Disclaimer: program și disponibilitate -->
        <div class="brand-card brand-card-glow p-8 mb-14">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 bg-brand-cyan-500/10 rounded-xl flex items-center justify-center text-brand-cyan-500 flex-shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
              </svg>
            </div>
            <div>
              <p class="brand-eyebrow mb-2">Program și disponibilitate</p>
              <h3 class="font-display text-surface-50 font-medium text-[18px] mb-3">Cum lucrăm efectiv</h3>
              <p class="text-surface-300 text-[14px] leading-relaxed font-light">
                Programul nostru de suport tehnic asistat este <strong class="text-surface-50">Luni–Vineri, 08:00–18:00</strong>. În afara acestui interval, sistemele clienților cu contract de mentenanță rămân sub <strong class="text-surface-50">monitorizare automată 24/7</strong>, cu alerte trimise echipei pentru incidențe majore. Disponibilitatea pentru intervenții în afara programului (weekend, sărbători, nopți) se contractează separat, prin pachet extins de SLA. Nu promitem un om de gardă 24/7 — promitem că știm mereu starea sistemului tău și că răspundem prompt când ai nevoie.
              </p>
            </div>
          </div>
        </div>

        <div class="grid lg:grid-cols-5 gap-10 lg:gap-12 items-start">
          <div class="lg:col-span-2">
            <p class="brand-eyebrow mb-4">— 02 / Brief</p>
            <h2 class="font-display text-[24px] md:text-[30px] font-medium text-surface-50">Solicită o consultație</h2>
            <p class="text-surface-300 text-[15px] leading-relaxed font-light mt-4">
              AXA IT oferă <strong class="text-surface-50">soluții IT complete</strong> — mentenanță, rețelistică, cloud, securitate și suport tehnic. Spune-ne cum te putem ajuta.
            </p>

            <div class="mt-8 border-t border-brand-cyan-500/15">
              <div class="brand-spec-row">
                <span class="label">Experiență</span>
                <span class="value">8+ ani (din 2016)</span>
                <span class="tag">Track</span>
              </div>
              <div class="brand-spec-row">
                <span class="label">Sisteme</span>
                <span class="value">150+</span>
                <span class="tag">Active</span>
              </div>
              <div class="brand-spec-row">
                <span class="label">Industrii</span>
                <span class="value">7</span>
                <span class="tag">Sectors</span>
              </div>
              <div class="brand-spec-row">
                <span class="label">Parteneri</span>
                <span class="value">TP-Link · Fortinet · Ubiquiti · Microsoft</span>
                <span class="tag">Stack</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-3">
            <form
              class="brand-card brand-card-glow p-8 md:p-10"
              onsubmit="event.preventDefault();"
            >
              <div class="grid sm:grid-cols-2 gap-5">
                <div class="sm:col-span-2">
                  <label for="name" class="block font-mono text-[10px] uppercase tracking-[0.18em] text-surface-400 mb-2">Nume complet</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    autocomplete="name"
                    class="w-full px-4 py-3 rounded-xl bg-ink-700 border border-brand-cyan-500/20 text-surface-50 placeholder:text-surface-500 focus:outline-none focus:ring-2 focus:ring-brand-cyan-500/40 focus:border-brand-cyan-500 focus:shadow-[0_0_0_4px_rgba(34,211,238,0.08)] transition-all"
                    placeholder="Ion Popescu"
                  />
                </div>
                <div>
                  <label for="email" class="block font-mono text-[10px] uppercase tracking-[0.18em] text-surface-400 mb-2">Email</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    autocomplete="email"
                    class="w-full px-4 py-3 rounded-xl bg-ink-700 border border-brand-cyan-500/20 text-surface-50 placeholder:text-surface-500 focus:outline-none focus:ring-2 focus:ring-brand-cyan-500/40 focus:border-brand-cyan-500 focus:shadow-[0_0_0_4px_rgba(34,211,238,0.08)] transition-all"
                    placeholder="you@companie.ro"
                  />
                </div>
                <div>
                  <label for="phone" class="block font-mono text-[10px] uppercase tracking-[0.18em] text-surface-400 mb-2">Telefon</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    autocomplete="tel"
                    class="w-full px-4 py-3 rounded-xl bg-ink-700 border border-brand-cyan-500/20 text-surface-50 placeholder:text-surface-500 focus:outline-none focus:ring-2 focus:ring-brand-cyan-500/40 focus:border-brand-cyan-500 focus:shadow-[0_0_0_4px_rgba(34,211,238,0.08)] transition-all"
                    placeholder="+40 7xx xxx xxx"
                  />
                </div>
                <div class="sm:col-span-2">
                  <label for="company" class="block font-mono text-[10px] uppercase tracking-[0.18em] text-surface-400 mb-2">Companie</label>
                  <input
                    type="text"
                    id="company"
                    name="company"
                    autocomplete="organization"
                    class="w-full px-4 py-3 rounded-xl bg-ink-700 border border-brand-cyan-500/20 text-surface-50 placeholder:text-surface-500 focus:outline-none focus:ring-2 focus:ring-brand-cyan-500/40 focus:border-brand-cyan-500 focus:shadow-[0_0_0_4px_rgba(34,211,238,0.08)] transition-all"
                    placeholder="Numele companiei"
                  />
                </div>
                <div class="sm:col-span-2">
                  <label for="message" class="block font-mono text-[10px] uppercase tracking-[0.18em] text-surface-400 mb-2">Mesaj</label>
                  <textarea
                    id="message"
                    name="message"
                    rows="5"
                    required
                    class="w-full px-4 py-3 rounded-xl bg-ink-700 border border-brand-cyan-500/20 text-surface-50 placeholder:text-surface-500 focus:outline-none focus:ring-2 focus:ring-brand-cyan-500/40 focus:border-brand-cyan-500 focus:shadow-[0_0_0_4px_rgba(34,211,238,0.08)] transition-all resize-y min-h-[120px]"
                    placeholder="Descrie pe scurt nevoia ta sau proiectul..."
                  ></textarea>
                </div>
              </div>
              <div class="mt-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                <p class="font-mono text-surface-500 text-[11px] uppercase tracking-[0.15em]">Trimiterea formularului va fi conectată la backend în curând.</p>
                <button
                  type="submit"
                  class="inline-flex items-center justify-center gap-2 bg-brand-cyan-500 hover:bg-brand-cyan-400 text-ink-900 font-mono text-[12px] uppercase tracking-[0.18em] font-semibold px-8 py-3.5 rounded-full transition-all hover:shadow-lg hover:shadow-brand-cyan-500/25"
                >
                  Trimite mesajul
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
                  </svg>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
